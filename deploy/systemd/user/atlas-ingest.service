[Unit]
Description=ATLAS ingestão de e-mail (shadow)
After=atlasd.service
Wants=atlasd.service

[Service]
Type=oneshot
Environment=ATLAS_HOME=%h/.local/share/atlas
Environment=ATLAS_REQUIRE_DAEMON=1
Environment=PATH=/run/current-system/sw/bin:/usr/bin:/bin
WorkingDirectory=%h/atlas
ExecStart=/run/current-system/sw/bin/python3 %h/atlas/bin/atlas ingest email --limit 50
TimeoutStartSec=45min
Nice=10
IOSchedulingClass=idle
UMask=0077
